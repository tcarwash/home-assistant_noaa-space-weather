{
  // Tasks for Supervisor-based Home Assistant devcontainer
  "$schema": "vscode://schemas/tasks",
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Home Assistant (Supervisor)",
      "type": "shell",
      "command": "supervisor_run",
      "problemMatcher": []
    },
    {
      "label": "Sync NOAA Space Weather to HA",
      "type": "shell",
      "command": "bash scripts/sync_integration.sh",
      "problemMatcher": []
    },
    {
      "label": "Restart Home Assistant Core",
      "type": "shell",
      "command": "ha core restart",
      "problemMatcher": []
    },
    {
      "label": "Tail Home Assistant Core Logs",
      "type": "shell",
      "command": "ha core logs -f",
      "problemMatcher": []
    },
    {
      "label": "Show HA config path",
      "type": "shell",
      "command": "bash -lc 'echo Detected config: $(readlink -f /config || echo /config); ls -la /config || true; ls -la /mnt/supervisor/homeassistant || true'",
      "problemMatcher": []
    }
  ]
}
